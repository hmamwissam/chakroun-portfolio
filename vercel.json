{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/dist/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/dist/index.html"
    },
    {
      "source": "/admin/:path((?!.*\\.).*)",
      "destination": "/admin/dist/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/dist/$1"
    },
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/client/dist/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/dist/$1"
    }
  ]
}
